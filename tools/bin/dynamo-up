#!/usr/bin/env bash
# Forced command of the sync-dynamo SSH key (Gitea secret DYNAMO_SSH_KEY; installed by ctl.sh up, FORCED_COMMANDS):
# serve the models whose MLflow alias `dynamo` is set (services/dynamo/README.md). Whatever the client asked to run
# ($SSH_ORIGINAL_COMMAND) is ignored, so the key can do this and nothing else.
set -euo pipefail
root=$(cd "$(dirname "$0")/../.." && pwd)
exec "$root/services/ctl.sh" dynamo up

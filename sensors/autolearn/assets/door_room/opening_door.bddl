(define (problem opening_door-0)
    (:domain behavior-1k)

    (:objects
        door.n.01_1 - door.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (not
            (open door.n.01_1)
        )
        (inroom door.n.01_1 corridor)
        (inroom floor.n.01_1 corridor)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (open ?door.n.01_1)
    )
)

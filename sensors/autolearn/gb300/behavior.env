# BEHAVIOR-1K on a GB300 node (setup.sh on arm64 builds what this points at). Source with `set -a`.
STATE=/tier1/mistral/flywheel/autolearn
OMNIGIBSON_DATA_PATH=$STATE/behavior-data
# Isaac's caches and their lock files on node-local disk: on /tier1 (wekafs) the app hangs after opening them
OMNIGIBSON_APPDATA_PATH=/tmp/$USER/behavior-appdata
OMNIGIBSON_HEADLESS=1
OMNI_KIT_ACCEPT_EULA=YES
# the nodes lack libGLU/libOpenGL (Isaac's MDL and RTX renderer need them): unpacked from Ubuntu's arm64 packages
LD_LIBRARY_PATH=$STATE/libs/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
# Isaac Sim 5.1 on arm64 refuses to start unless the system's libgomp is preloaded (and torch.libs' one, which the
# cu128 torch here doesn't have)
LD_PRELOAD=/lib/aarch64-linux-gnu/libgomp.so.1
# PyRoki's IK (adapter/ik.py) on the CPU: one arm's solve is small, and JAX on a GPU would take memory from Isaac and
# always pick GPU 0, as Slurm here leaves every GPU visible to every job
JAX_PLATFORMS=cpu

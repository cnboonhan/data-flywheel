# MLflow with the mlflow-oidc-auth plugin: Keycloak login for the UI, personal access
# tokens for API clients, per-experiment permissions. Pure-Python wheels, so it builds on any arch.
FROM ghcr.io/mlflow/mlflow:v3.17.0
RUN pip install --no-cache-dir "mlflow-oidc-auth==9.0.4" "mlflow==3.17.0" boto3

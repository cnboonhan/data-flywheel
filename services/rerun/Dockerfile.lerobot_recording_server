# LeRobot episodes and big ROS 2 bags as Rerun recordings (lerobot_recording_server.py, mcap_recording.py): the viewer's SDK,
# ffmpeg to cut each camera's span of the chunk video and to encode a bag's camera frames, pyarrow for the parquet, mcap and
# mcap-ros2-support to read and decode the bags. Same Rerun version as the viewer, so its recordings always open there.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/* && \
    pip install --no-cache-dir rerun-sdk==0.38.1 pyarrow==21.0.0 numpy mcap==1.2.2 mcap-ros2-support==0.5.5 && rerun analytics disable
COPY lerobot_recording_server.py mcap_recording.py /app/
CMD ["python3", "/app/lerobot_recording_server.py"]

{
	admin off
	# Certificates come from Caddy's own CA. The root cert is written to
	# /data/caddy/pki/authorities/local/root.crt; clients trust that file.
	local_certs
	auto_https disable_redirects
	# Request count, latency, sizes and requests in flight per site (host), served on :9180 below for Prometheus.
	metrics {
		per_host
	}
}

# Prometheus's endpoint for the metrics above: plain HTTP, inside the compose network only (the port isn't published).
http://:9180 {
	metrics /metrics
}

# Everything is on one port: 8443 inside the container, published as CADDY_PORT
# (docker-compose.yml), which links and redirects carry. Upstreams are compose
# service names with the port each app listens on (docker-compose.yml).
# Apps that can serve under a path are path-routed on the base host; the three
# that can't (FiftyOne, Rerun, the S3 API) get a subdomain of it. SERVICE_HOST
# is a name that resolves to the node from anywhere (sslip.io); through an SSH
# tunnel, map it and the subdomains to 127.0.0.1 in /etc/hosts.

# Single sign-on for apps without a login of their own: Caddy asks
# oauth2-proxy, which holds a session cookie for .SERVICE_HOST; a browser
# without one is sent to Keycloak via /oauth2/start and comes back here.
(sso) {
	reverse_proxy oauth2-proxy:4180 {
		method GET
		rewrite /oauth2/auth
		header_up X-Forwarded-Method {method}
		header_up X-Forwarded-Uri {uri}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
		@ok status 2xx
		handle_response @ok {
			request_header X-Auth-Request-User {rp.header.X-Auth-Request-User}
			request_header X-Auth-Request-Email {rp.header.X-Auth-Request-Email}
			request_header X-Auth-Request-Groups {rp.header.X-Auth-Request-Groups}
		}
		@denied status 401 403
		handle_response @denied {
			redir * https://{$SERVICE_HOST}:{$CADDY_PORT}/oauth2/start?rd={scheme}://{http.request.hostport}{uri} 302
		}
	}
}

https://{$SERVICE_HOST}:8443 {
	log {
		output stdout
		format console
	}

	redir /mlflow /mlflow/
	redir /grafana /grafana/
	redir /gitea /gitea/
	redir /auth /auth/
	redir /s3 https://s3.{$SERVICE_HOST}:{$CADDY_PORT}/ui/
	redir /fiftyone https://fiftyone.{$SERVICE_HOST}:{$CADDY_PORT}/
	redir /rerun https://rerun.{$SERVICE_HOST}:{$CADDY_PORT}/

	# Keycloak (own login UI) and the oauth2-proxy endpoints (sign-in, callback, sign-out).
	handle /auth/* {
		reverse_proxy keycloak:8080
	}
	handle /oauth2/* {
		reverse_proxy oauth2-proxy:4180 {
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Native OIDC logins (Keycloak is an auth source in both).
	handle /gitea/* {
		reverse_proxy gitea:3000
	}
	handle /grafana/* {
		reverse_proxy grafana:3000
	}
	# MLflow keeps its own accounts: API clients (training jobs) authenticate
	# with Keycloak through the mlflow-oidc-auth plugin; API clients use access tokens.
	handle /mlflow/* {
		reverse_proxy mlflow:5000 {
			header_up X-Forwarded-Prefix /mlflow
		}
	}

	# Log push from outside (robots, laptops, nodes): a bearer token instead of the SSO login.
	# Only POST /loki/api/v1/push; an empty LOKI_PUSH_TOKEN never matches. Queries stay behind SSO.
	@loki_push {
		method POST
		path /loki/api/v1/push
		expression `{env.LOKI_PUSH_TOKEN} != "" && {http.request.header.Authorization} == "Bearer " + {env.LOKI_PUSH_TOKEN}`
	}
	handle @loki_push {
		request_header -Authorization
		reverse_proxy loki:3100
	}

	# Metric pushes from outside (e.g. prometheus/slurm_exporter.py --push): a bearer token, Pushgateway's push API only;
	# an empty PUSHGATEWAY_TOKEN never matches. Prometheus reads the Pushgateway inside the compose network.
	@pushgateway {
		method PUT POST DELETE
		path /pushgateway/metrics/job/*
		expression `{env.PUSHGATEWAY_TOKEN} != "" && {http.request.header.Authorization} == "Bearer " + {env.PUSHGATEWAY_TOKEN}`
	}
	handle @pushgateway {
		request_header -Authorization
		uri strip_prefix /pushgateway
		reverse_proxy pushgateway:9091
	}

	# No login of their own: SSO at the proxy.
	handle /loki/* {
		import sso
		reverse_proxy loki:3100
	}

	handle /ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		file_server
	}
	# The landing page's model load table: one fixed, read-only Prometheus query (requests and tokens per second, requests
	# in progress, up/down and generation speed per served model on Dynamo and Triton, GPU use of their nodes), so nothing else in
	# Prometheus is reachable from this page, which has no login.
	# The landing page's model details: the LLM gateway's /v1/models (context window, inputs, licence per served model).
	handle /status/models {
		rewrite * /v1/models
		reverse_proxy {$LLM_GATEWAY_ADDR:127.0.0.1}:8199
	}
	handle /status/load {
		rewrite * /api/v1/query?query=label_replace%28label_replace%28sum%20by%20%28model%29%20%28rate%28llm_gateway_requests_total%5B5m%5D%29%29%2C%20%22m%22%2C%20%22rps%22%2C%20%22%22%2C%20%22%22%29%2C%20%22server%22%2C%20%22dynamo%22%2C%20%22%22%2C%20%22%22%29%20or%20label_replace%28label_replace%28sum%20by%20%28model%29%20%28rate%28%7B__name__%3D%22vllm%3Ageneration_tokens_total%22%2C%20job%3D%22dynamo%22%7D%5B5m%5D%29%29%2C%20%22m%22%2C%20%22tps%22%2C%20%22%22%2C%20%22%22%29%2C%20%22server%22%2C%20%22dynamo%22%2C%20%22%22%2C%20%22%22%29%20or%20label_replace%28label_replace%28sum%20by%20%28model%29%20%28%7B__name__%3D~%22vllm%3Anum_requests_%28running%7Cwaiting%29%22%2C%20job%3D%22dynamo%22%7D%29%2C%20%22m%22%2C%20%22busy%22%2C%20%22%22%2C%20%22%22%29%2C%20%22server%22%2C%20%22dynamo%22%2C%20%22%22%2C%20%22%22%29%20or%20label_replace%28label_replace%28max%20by%20%28model%29%20%28llm_gateway_served%29%2C%20%22m%22%2C%20%22up%22%2C%20%22%22%2C%20%22%22%29%2C%20%22server%22%2C%20%22dynamo%22%2C%20%22%22%2C%20%22%22%29%20or%20label_replace%28label_replace%28sum%20by%20%28model%29%20%28rate%28nv_inference_request_success%7Bjob%3D%22triton%22%7D%5B5m%5D%29%29%2C%20%22m%22%2C%20%22rps%22%2C%20%22%22%2C%20%22%22%29%2C%20%22server%22%2C%20%22triton%22%2C%20%22%22%2C%20%22%22%29%20or%20label_replace%28label_replace%28max%20by%20%28model%29%20%28nv_inference_pending_request_count%7Bjob%3D%22triton%22%7D%29%2C%20%22m%22%2C%20%22busy%22%2C%20%22%22%2C%20%22%22%29%2C%20%22server%22%2C%20%22triton%22%2C%20%22%22%2C%20%22%22%29%20or%20label_replace%28avg%20by%20%28instance%29%20%28DCGM_FI_DEV_GPU_UTIL%7Binstance%3D~%22{$SERVING_NODES}%22%7D%29%2C%20%22m%22%2C%20%22gpu%22%2C%20%22%22%2C%20%22%22%29%20or%20label_replace%28label_replace%28sum%20by%20%28model%29%20%28rate%28%7B__name__%3D%22vllm%3Arequest_time_per_output_token_seconds_count%22%2C%20job%3D%22dynamo%22%7D%5B15m%5D%29%29%20%2F%20sum%20by%20%28model%29%20%28rate%28%7B__name__%3D%22vllm%3Arequest_time_per_output_token_seconds_sum%22%2C%20job%3D%22dynamo%22%7D%5B15m%5D%29%29%2C%20%22m%22%2C%20%22speed%22%2C%20%22%22%2C%20%22%22%29%2C%20%22server%22%2C%20%22dynamo%22%2C%20%22%22%2C%20%22%22%29
		reverse_proxy prometheus:9090
	}
	# assets/devroles/*.md are only included into the landing page by its template, never served on their own (raw
	# Markdown); this site has no login.
	handle /assets/devroles/* {
		respond 404
	}
	# Browse Data (services/browse): the raw and processed buckets as folders, behind SSO. Its links open bags and LeRobot
	# episodes in the viewer on rerun.<host> with the path token, and each LeRobot dataset's page (rerun-lerobot, from its
	# meta/) is at /data/dataset/<bucket>/<path>/; only Caddy adds the token (header_up replaces any the client sent).
	redir /data /data/
	# A big bag's page (rerun-lerobot): converts it to a recording the web viewer can hold, with progress, then opens it
	handle /data/bag* {
		route {
			import sso
			uri strip_prefix /data
			reverse_proxy rerun-lerobot:8080 {
				header_up X-Rerun-Token {env.RERUN_RAW_TOKEN}
				header_up X-Viewer-Host rerun.{$SERVICE_HOST}:{$CADDY_PORT}
			}
		}
	}
	handle /data/dataset/* {
		route {
			import sso
			uri strip_prefix /data
			reverse_proxy rerun-lerobot:8080 {
				header_up X-Rerun-Token {env.RERUN_RAW_TOKEN}
				header_up X-Viewer-Host rerun.{$SERVICE_HOST}:{$CADDY_PORT}
				header_up X-Browse-Base /data
			}
		}
	}
	handle /data/* {
		route {
			import sso
			uri strip_prefix /data
			root * /buckets
			file_server {
				browse /etc/caddy/browse/browse.html
				hide .*
			}
		}
	}
	# Local apps (site/local/, gitignored; README: local apps): *.routes are handle blocks on this host. The folder is
	# only read by Caddy and the landing page's template, never served: its files name hosts and ports outside the stack.
	import /srv/local/*.routes
	handle /local/* {
		respond 404
	}
	handle {
		root * /srv
		templates
		file_server
	}
}

# FiftyOne App: redirects every sub-path to /, hence a subdomain.
https://fiftyone.{$SERVICE_HOST}:8443 {
	import sso
	reverse_proxy fiftyone:5151
}

# Viewers on other origins (Foxglove at app.foxglove.dev) read bags in byte ranges: CORS for GET and the Range
# header, and an answer to the preflight. The path token still gates the file.
(bag_cors) {
	header Access-Control-Allow-Origin "*"
	header Access-Control-Allow-Headers "Range"
	header Access-Control-Expose-Headers "Accept-Ranges, Content-Length, Content-Range"
	@preflight method OPTIONS
	respond @preflight 204
}

# Rerun web viewer plus the raw files it imports itself, e.g. MCAP bags
# (?url=https://rerun.<host>:8443/raw/<token>/<group>/<dataset>/<path>.mcap).
https://rerun.{$SERVICE_HOST}:8443 {
	# Rerun's viewer fetches files without cookies, so links carry a path token instead:
	# /raw/<RERUN_RAW_TOKEN>/<path>, bags only (.mcap, .bag); an empty token never matches.
	@raw_token {
		path *.mcap *.bag
		expression `{env.RERUN_RAW_TOKEN} != "" && {path}.startsWith("/raw/" + {env.RERUN_RAW_TOKEN} + "/")`
	}
	handle @raw_token {
		import bag_cors
		uri path_regexp ^/raw/[^/]+ ""
		root * /raw
		file_server
	}
	# LeRobot episodes, the same token: rerun-lerobot builds /lerobot/<group>/<dataset>/<root>/episode_<n>.rrd
	@lerobot_token {
		path *.rrd
		expression `{env.RERUN_RAW_TOKEN} != "" && {path}.startsWith("/lerobot/" + {env.RERUN_RAW_TOKEN} + "/")`
	}
	handle @lerobot_token {
		uri path_regexp ^/lerobot/[^/]+ /lerobot
		reverse_proxy rerun-lerobot:8080
	}
	# The same two for the processed bucket: /processed/<token>/<path> bags, /lerobot-processed/<token>/... episodes
	@processed_token {
		path *.mcap *.bag
		expression `{env.RERUN_RAW_TOKEN} != "" && {path}.startsWith("/processed/" + {env.RERUN_RAW_TOKEN} + "/")`
	}
	handle @processed_token {
		import bag_cors
		uri path_regexp ^/processed/[^/]+ ""
		root * /processed
		file_server
	}
	@lerobot_processed_token {
		path *.rrd
		expression `{env.RERUN_RAW_TOKEN} != "" && {path}.startsWith("/lerobot-processed/" + {env.RERUN_RAW_TOKEN} + "/")`
	}
	handle @lerobot_processed_token {
		uri path_regexp ^/lerobot-processed/[^/]+ /lerobot-processed
		reverse_proxy rerun-lerobot:8080
	}
	# A big bag's converted recording (rerun-lerobot, /bag-rrd/<token>/<bucket>/<path>.mcap.rrd), the same token
	@bag_token {
		path *.rrd
		expression `{env.RERUN_RAW_TOKEN} != "" && {path}.startsWith("/bag-rrd/" + {env.RERUN_RAW_TOKEN} + "/")`
	}
	handle @bag_token {
		uri path_regexp ^/bag-rrd/[^/]+ /bag-rrd
		reverse_proxy rerun-lerobot:8080
	}
	# route keeps the written order: Caddy otherwise runs file_server before the
	# imported SSO check, which left the files readable without a login.
	handle /raw/* {
		route {
			import sso
			uri strip_prefix /raw
			root * /raw
			file_server
		}
	}
	handle /processed/* {
		route {
			import sso
			uri strip_prefix /processed
			root * /processed
			file_server
		}
	}
	# Browse Data and the dataset pages moved to the main host (services/browse): old links redirect there
	handle_path /browse* {
		redir https://{$SERVICE_HOST}:{$CADDY_PORT}/data{uri} 302
	}
	handle_path /dataset/* {
		redir https://{$SERVICE_HOST}:{$CADDY_PORT}/data/dataset{uri} 302
	}
	handle {
		import sso
		reverse_proxy rerun:9090
	}
}

# Triton for programs (robots, evaluation jobs): HTTP/REST (/v2/...) and gRPC on one name, no token. Changing the
# server (loading and unloading models, log, trace and shared-memory settings) isn't reachable from here: sync-triton
# does that on Triton's own port with its key. gRPC requests are told apart by their content type.
https://triton.{$SERVICE_HOST}:8443 {
	@admin_http path_regexp ^/v2/(repository/models/[^/]+/(load|unload)|logging|trace(/setting)?|models/[^/]+/trace/setting|(system|cuda)sharedmemory(/.*)?)$
	@admin_grpc path /inference.GRPCInferenceService/RepositoryModelLoad /inference.GRPCInferenceService/RepositoryModelUnload /inference.GRPCInferenceService/LogSettings /inference.GRPCInferenceService/TraceSetting /inference.GRPCInferenceService/SystemSharedMemory* /inference.GRPCInferenceService/CudaSharedMemory*
	@grpc header Content-Type application/grpc*
	handle @admin_http {
		respond "Triton: models are loaded and unloaded by sync-triton (the Gitea repo triton, a model repository), not from outside" 403
	}
	handle @admin_grpc {
		respond "Triton: models are loaded and unloaded by sync-triton (the Gitea repo triton, a model repository), not from outside" 403
	}
	# Triton's default ports: gRPC on 8001 (HTTP/2, cleartext inside), HTTP on 8000.
	handle @grpc {
		reverse_proxy h2c://{$TRITON_ADDR}:8101 {
			header_up triton-key {env.TRITON_KEY}
		}
	}
	handle {
		reverse_proxy {$TRITON_ADDR}:8100 {
			header_up triton-key {env.TRITON_KEY}
		}
	}
}

# The language models on Dynamo (services/dynamo): open, no SSO and no token; the gateway on DYNAMO_HEAD checks only the
# critical-traffic token (LLM_CRITICAL_TOKEN). Answers stream through as they come.
https://llm.{$SERVICE_HOST}:8443 {
	reverse_proxy {$LLM_GATEWAY_ADDR:127.0.0.1}:8199 {
		flush_interval -1
	}
}

# Local apps on a subdomain of their own (site/local/*.caddy, gitignored; README: local apps). A glob that matches no
# file only logs a warning, so the stack starts without any.
import /srv/local/*.caddy

# S3 API and the gateway's web UI (under /ui). SigV4 signs the request path,
# so no prefix and no SSO here: clients hold access keys, which ctl.sh issues
# per user; the UI logs in with those keys.
https://s3.{$SERVICE_HOST}:8443 {
	handle /ui/* {
		import sso
		reverse_proxy versitygw:7070
	}
	reverse_proxy versitygw:7070
}


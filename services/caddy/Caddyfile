{
	admin off
	# Certificates come from Caddy's own CA. The root cert is written to
	# /data/caddy/pki/authorities/local/root.crt; clients trust that file.
	local_certs
	auto_https disable_redirects
}

# Everything is on one port. Apps that can serve under a path are path-routed
# on the base host; the three that can't (FiftyOne, Rerun, the S3 API) get a
# subdomain of it. SERVICE_HOST is a name that resolves to the node from
# anywhere (sslip.io); through an SSH tunnel, map it and the subdomains to
# 127.0.0.1 in /etc/hosts.

# Single sign-on for apps without a login of their own: Caddy asks
# oauth2-proxy, which holds a session cookie for .SERVICE_HOST; a browser
# without one is sent to Keycloak via /oauth2/start and comes back here.
(sso) {
	reverse_proxy oauth2-proxy:4180 {
		method GET
		rewrite /oauth2/auth
		header_up X-Forwarded-Method {method}
		header_up X-Forwarded-Uri {uri}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
		@ok status 2xx
		handle_response @ok {
			request_header X-Auth-Request-User {rp.header.X-Auth-Request-User}
			request_header X-Auth-Request-Email {rp.header.X-Auth-Request-Email}
			request_header X-Auth-Request-Groups {rp.header.X-Auth-Request-Groups}
		}
		@denied status 401 403
		handle_response @denied {
			redir * https://{$SERVICE_HOST}:{$CADDY_PORT}/oauth2/start?rd={scheme}://{http.request.hostport}{uri} 302
		}
	}
}

https://{$SERVICE_HOST}:8443 {
	log {
		output stdout
		format console
	}

	redir /mlflow /mlflow/
	redir /grafana /grafana/
	redir /gitea /gitea/
	redir /auth /auth/
	redir /s3 https://s3.{$SERVICE_HOST}:{$CADDY_PORT}/ui/
	redir /fiftyone https://fiftyone.{$SERVICE_HOST}:{$CADDY_PORT}/
	redir /rerun https://rerun.{$SERVICE_HOST}:{$CADDY_PORT}/

	# Keycloak (own login UI) and the oauth2-proxy endpoints (sign-in, callback, sign-out).
	handle /auth/* {
		reverse_proxy keycloak:8080
	}
	handle /oauth2/* {
		reverse_proxy oauth2-proxy:4180 {
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Native OIDC logins (Keycloak is an auth source in both).
	handle /gitea/* {
		reverse_proxy gitea:3000
	}
	handle /grafana/* {
		reverse_proxy grafana:3000
	}
	# MLflow keeps its own accounts: API clients (training jobs) authenticate
	# with Keycloak through the mlflow-oidc-auth plugin; API clients use access tokens.
	handle /mlflow/* {
		reverse_proxy mlflow:5000 {
			header_up X-Forwarded-Prefix /mlflow
		}
	}

	# Log push from outside (robots, laptops, nodes): a bearer token instead of the SSO login.
	# Only POST /loki/api/v1/push; an empty LOKI_PUSH_TOKEN never matches. Queries stay behind SSO.
	@loki_push {
		method POST
		path /loki/api/v1/push
		expression `{env.LOKI_PUSH_TOKEN} != "" && {http.request.header.Authorization} == "Bearer " + {env.LOKI_PUSH_TOKEN}`
	}
	handle @loki_push {
		request_header -Authorization
		reverse_proxy loki:3100
	}

	# No login of their own: SSO at the proxy.
	handle /loki/* {
		import sso
		reverse_proxy loki:3100
	}

	handle /ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		file_server
	}
	handle {
		root * /srv
		templates
		file_server
	}
}

# FiftyOne App: redirects every sub-path to /, hence a subdomain.
https://fiftyone.{$SERVICE_HOST}:8443 {
	import sso
	reverse_proxy fiftyone:5151
}

# Rerun web viewer plus the episode recordings it opens (?url=https://rerun.<host>:8443/data/<dataset>/<episode>.rrd).
https://rerun.{$SERVICE_HOST}:8443 {
	# route keeps the written order: Caddy otherwise runs handle_path/file_server before the
	# imported SSO check, which left /data/ readable without a login.
	handle /data/* {
		route {
			import sso
			uri strip_prefix /data
			root * /rerun
			file_server
		}
	}
	handle {
		import sso
		reverse_proxy rerun:9090
	}
}

# S3 API and the gateway's web UI (under /ui). SigV4 signs the request path,
# so no prefix and no SSO here: clients hold access keys, which ctl.sh issues
# per user; the UI logs in with those keys.
https://s3.{$SERVICE_HOST}:8443 {
	handle /ui/* {
		import sso
		reverse_proxy versitygw:7070
	}
	reverse_proxy versitygw:7070
}


{
 "uid": "gpu-job",
 "title": "Slurm job",
 "tags": [
  "flywheel"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "editable": false,
 "description": "One Slurm job's CPU, RAM and GPUs over time, from the Slurm job pusher (services/prometheus/slurm_exporter.py) joined with node_exporter and dcgm-exporter.",
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "job",
    "label": "job",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values({job=\"slurm_jobs\", __name__=~\"slurm_job_cpus|slurm_job_gpu\"}, job_id)",
     "refId": "job"
    },
    "definition": "label_values({job=\"slurm_jobs\", __name__=~\"slurm_job_cpus|slurm_job_gpu\"}, job_id)",
    "refresh": 2,
    "sort": 3,
    "includeAll": false,
    "multi": false
   }
  ]
 },
 "links": [
  {
   "title": "Cluster usage",
   "type": "link",
   "url": "/grafana/d/cluster-usage/cluster-usage",
   "keepTime": true
  }
 ],
 "panels": [
  {
   "type": "table",
   "title": "Job",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 8,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "format": "table",
     "expr": "group by (job_id, user, job_name, partition) ({__name__=~\"slurm_job_cpus|slurm_job_gpu\", job=\"slurm_jobs\", job_id=\"$job\"})"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Value": true
      },
      "renameByName": {
       "job_id": "Job",
       "user": "User",
       "job_name": "Name",
       "partition": "Partition"
      }
     }
    }
   ],
   "options": {
    "showHeader": true
   },
   "id": 1
  },
  {
   "type": "stat",
   "title": "Nodes",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 8,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "expr": "count(count by (instance) (slurm_job_cpu{job=\"slurm_jobs\", job_id=\"$job\"}))"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "noValue": "-",
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   },
   "id": 2
  },
  {
   "type": "stat",
   "title": "CPUs",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 12,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "expr": "max(slurm_job_cpus{job=\"slurm_jobs\", job_id=\"$job\"})"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "noValue": "-",
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   },
   "id": 3
  },
  {
   "type": "stat",
   "title": "RAM requested",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 16,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "expr": "max(slurm_job_memory_bytes{job=\"slurm_jobs\", job_id=\"$job\"} > 0)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "decimals": 1,
     "noValue": "-",
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   },
   "id": 4
  },
  {
   "type": "stat",
   "title": "GPUs",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 20,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "expr": "count(slurm_job_gpu{job=\"slurm_jobs\", job_id=\"$job\"})"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "noValue": "-",
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   },
   "id": 5
  },
  {
   "type": "timeseries",
   "title": "CPU: cores busy and allocated",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 0,
    "y": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(node_cpu_seconds_total{mode!=\"idle\"}[2m]) * on (instance, cpu) group_left () slurm_job_cpu{job=\"slurm_jobs\", job_id=\"$job\"})",
     "legendFormat": "cores busy"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(slurm_job_cpus{job=\"slurm_jobs\", job_id=\"$job\"})",
     "legendFormat": "CPUs allocated"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 6
  },
  {
   "type": "timeseries",
   "title": "RAM: in use and requested",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 12,
    "y": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(slurm_job_rss_bytes{job=\"slurm_jobs\", job_id=\"$job\"})",
     "legendFormat": "in use"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(slurm_job_memory_bytes{job=\"slurm_jobs\", job_id=\"$job\"} > 0)",
     "legendFormat": "requested"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 7
  },
  {
   "type": "timeseries",
   "title": "GPU utilisation per GPU",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 0,
    "y": 13
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "DCGM_FI_DEV_GPU_UTIL * on (instance, gpu) group_left () slurm_job_gpu{job=\"slurm_jobs\", job_id=\"$job\"}",
     "legendFormat": "{{instance}} GPU {{gpu}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 8
  },
  {
   "type": "timeseries",
   "title": "VRAM per GPU",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 12,
    "y": 13
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (instance, gpu) (label_replace(gpu_process_memory_bytes{job=\"gpu_processes\", slurm_job=\"$job\"}, \"instance\", \"$1\", \"node\", \"(.*)\"))",
     "legendFormat": "{{instance}} GPU {{gpu}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 9,
   "description": "GPU memory the job's processes hold on each of its GPUs (prometheus/gpu_processes.py; DCGM's used memory also counts file cache on GB300 nodes)."
  },
  {
   "type": "timeseries",
   "title": "Tensor Core activity per GPU",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 0,
    "y": 22
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "DCGM_FI_PROF_PIPE_TENSOR_ACTIVE * on (instance, gpu) group_left () slurm_job_gpu{job=\"slurm_jobs\", job_id=\"$job\"} * 100",
     "legendFormat": "{{instance}} GPU {{gpu}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 10
  },
  {
   "type": "timeseries",
   "title": "Power per GPU",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 12,
    "y": 22
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "DCGM_FI_DEV_POWER_USAGE * on (instance, gpu) group_left () slurm_job_gpu{job=\"slurm_jobs\", job_id=\"$job\"}",
     "legendFormat": "{{instance}} GPU {{gpu}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "watt",
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 11
  }
 ]
}
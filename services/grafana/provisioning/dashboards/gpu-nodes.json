  {
   "type": "table",
   "title": "GPU jobs now",
   "description": "Running Slurm jobs and the GPUs they hold, from the Slurm job pusher (services/slurm-exporter); only the jobs its account can see.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 10,
    "w": 18,
    "x": 0,
    "y": 41
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "instant": true,
     "format": "table",
     "expr": "count by (job_id, user, job_name, partition) (slurm_job_gpu{job=\"slurm_jobs\", partition=~\"$partition\"})"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "instant": true,
     "format": "table",
     "expr": "avg by (job_id, user, job_name, partition) (DCGM_FI_DEV_GPU_UTIL * on (instance, gpu) group_left (job_id, user, job_name, partition) slurm_job_gpu{job=\"slurm_jobs\", partition=~\"$partition\"})"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "instant": true,
     "format": "table",
     "expr": "sum by (job_id, user, job_name, partition) (DCGM_FI_DEV_FB_USED * on (instance, gpu) group_left (job_id, user, job_name, partition) slurm_job_gpu{job=\"slurm_jobs\", partition=~\"$partition\"}) / 1024"
    },
    {
     "refId": "D",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "instant": true,
     "format": "table",
     "expr": "avg by (job_id, user, job_name, partition) (DCGM_FI_DEV_POWER_USAGE * on (instance, gpu) group_left (job_id, user, job_name, partition) slurm_job_gpu{job=\"slurm_jobs\", partition=~\"$partition\"})"
    }
   ],
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "job_id": "Job",
       "user": "User",
       "job_name": "Name",
       "partition": "Partition",
       "Value #A": "GPUs",
       "Value #B": "GPU util %",
       "Value #C": "GPU memory GiB",
       "Value #D": "Power per GPU W"
      },
      "indexByName": {
       "job_id": 0,
       "user": 1,
       "job_name": 2,
       "partition": 3,
       "Value #A": 4,
       "Value #B": 5,
       "Value #C": 6,
       "Value #D": 7
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "GPUs",
        "desc": true
       }
      ]
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 1
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "GPU util %"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background",
         "mode": "basic"
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "thresholds"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "red",
           "value": null
          },
          {
           "color": "orange",
           "value": 5
          },
          {
           "color": "green",
           "value": 30
          }
         ]
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "GPUs"
      },
      "properties": [
       {
        "id": "decimals",
        "value": 0
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "footer": {
     "show": true,
     "reducer": [
      "sum"
     ],
     "fields": [
      "GPUs",
      "GPU memory GiB"
     ]
    }
   },
   "id": 20
  },

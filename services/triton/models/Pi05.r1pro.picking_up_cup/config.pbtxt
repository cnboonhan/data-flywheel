# π0.5 fine-tuned on BEHAVIOR-1K picking_up_cup (Galaxea R1 Pro, joint space), on the Python backend (1/model.py, which
# runs 1/serve_pi05.py in the image's openpi venv): Triton's model configuration format. The weights are the MLflow
# registered model and version below (a checkpoint step directory with params/ and assets/), which sync.py reads in
# place from /mlflow (it adds the parameter `weights`). openpi_config is a config 1/r1pro.py registers; prompt is the
# instruction when a request gives none. state and action are r1pro's 20-value joint vector. One instance on every GPU
# Triton sees; `gpus: [ N ]` in instance_group pins it to one.
backend: "python"
max_batch_size: 0
input { name: "state" data_type: TYPE_FP32 dims: [ 20 ] }
input { name: "cam_high" data_type: TYPE_UINT8 dims: [ -1, -1, 3 ] }
input { name: "cam_left_wrist" data_type: TYPE_UINT8 dims: [ -1, -1, 3 ] }
input { name: "cam_right_wrist" data_type: TYPE_UINT8 dims: [ -1, -1, 3 ] }
input { name: "prompt" data_type: TYPE_STRING dims: [ 1 ] optional: true }
output { name: "action" data_type: TYPE_FP32 dims: [ -1, 20 ] }
instance_group [ { count: 1, kind: KIND_GPU } ]
parameters { key: "mlflow_model" value { string_value: "Pi05.r1pro.picking_up_cup" } }
parameters { key: "mlflow_version" value { string_value: "1" } }
parameters { key: "openpi_config" value { string_value: "pi05_r1pro_picking_up_cup" } }
parameters { key: "prompt" value { string_value: "pick up the cup" } }

# Copy to .env (gitignored) and fill in the secrets.

# Node the stack runs on. ctl.sh reaches it over ssh; Caddy/Grafana/Prometheus use it in URLs.
SERVICE_NODE=C2-GB300-02-C03
SERVICE_HOST=flywheel.10.80.81.30.sslip.io

# Where every service keeps its state: ${STATE_DIR}/<service>
STATE_DIR=/tier1/htx_boonhan/services

# Containers run as this uid:gid so files under STATE_DIR stay owned by you.
SERVICE_UID=5003
SERVICE_GID=8010

CADDY_PORT=8443   # the only published port; subdomains fiftyone./rerun./s3. of SERVICE_HOST share it

# One admin login for everything: MLflow admin, Grafana admin, S3 root
# (access key = user, secret key = password), and the proxy login in front
# of Prometheus and Loki. At least 12 characters (MLflow's rule).
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-change-me

MLFLOW_SECRET_KEY=change-me   # random string, signs MLflow's CSRF tokens

S3_REGION=us-east-1
# Set to debug to log every S3 request and response (secrets masked).
S3_LOG_LEVEL=silent

PROM_RETENTION=30d

# gid of /var/run/docker.sock on the service node (`stat -c %g /var/run/docker.sock`); the Actions runner joins it.
DOCKER_GID=983

# Single sign-on (Keycloak at /auth, oauth2-proxy in front of apps without a login).
KC_DB_PASSWORD=change-me
KC_GITEA_SECRET=change-me
KC_GRAFANA_SECRET=change-me
KC_OAUTH2_SECRET=change-me
OAUTH2_COOKIE_SECRET=change-me-32-bytes-base64

# Settings for services/ctl.sh and docker-compose.yml. Copy to .env (gitignored) and fill in the secrets.

# --- Where and how the stack runs ---
# Host that runs the containers. ctl.sh runs docker compose there (over ssh when started elsewhere).
SERVICE_NODE=C2-GB300-02-C03
# Name every client uses to reach the stack; must resolve to SERVICE_NODE. fiftyone./rerun./s3. subdomains
# of it serve FiftyOne, Rerun and the S3 API. flywheel.<node ip>.sslip.io needs no DNS setup.
SERVICE_HOST=flywheel.10.80.81.30.sslip.io
# The only published port (HTTPS, all services and subdomains).
CADDY_PORT=8443
# Persistent state: databases, buckets, CA, policy envs, caches, checkpoints, Slurm logs ($STATE_DIR/<service>).
STATE_DIR=/tier1/htx_boonhan/services
# uid:gid the containers run as, so files under STATE_DIR stay owned by you (`id -u`, `id -g`).
SERVICE_UID=5003
SERVICE_GID=8010
# gid of the Docker socket on SERVICE_NODE (`stat -c %g /var/run/docker.sock`); lets the Actions runner start job containers.
DOCKER_GID=983

# --- Admin login (applied everywhere on first start) ---
# Admin of Keycloak's flywheel realm, Gitea, Grafana and MLflow; S3 root access key.
ADMIN_USER=admin
# Its password and the S3 root secret key. At least 12 characters. Changing it later: see keycloak/README.md.
ADMIN_PASSWORD=change-me-change-me

# --- Single sign-on (Keycloak + oauth2-proxy); random strings, e.g. `openssl rand -hex 24` ---
# Password of Keycloak's Postgres database.
KC_DB_PASSWORD=change-me
# OIDC client secret of client `gitea`.
KC_GITEA_SECRET=change-me
# OIDC client secret of client `grafana`.
KC_GRAFANA_SECRET=change-me
# OIDC client secret of client `mlflow` (mlflow-oidc-auth plugin).
KC_MLFLOW_SECRET=change-me
# OIDC client secret of client `oauth2-proxy` (gates FiftyOne, Rerun, Loki, the S3 UI).
KC_OAUTH2_SECRET=change-me
# Encrypts oauth2-proxy's session cookie: 32 bytes, base64 (`openssl rand -base64 32 | tr -- '+/' '-_'`).
OAUTH2_COOKIE_SECRET=change-me-32-bytes-base64

# --- Services ---
# Bearer token for pushing logs from outside: POST https://$SERVICE_HOST:$CADDY_PORT/loki/api/v1/push with
# "Authorization: Bearer <token>" (random string, e.g. `openssl rand -hex 24`). Empty disables the route.
LOKI_PUSH_TOKEN=
# Path token for raw bags in Rerun links: Rerun's viewer fetches files without cookies, so SSO can't cover them.
# Bags (.mcap, .bag) are served without login at https://rerun.$SERVICE_HOST:$CADDY_PORT/raw/<token>/<path>; sync-fiftyone-raw
# writes those links into FiftyOne. Anyone holding a link can read bags. Change it to revoke links (`ctl.sh up`, then rerun
# the sync). Random string, e.g. `openssl rand -hex 24`. Empty disables the route and the links.
RERUN_RAW_TOKEN=
# Signs MLflow's session cookies and CSRF tokens (random string).
MLFLOW_SECRET_KEY=change-me
# Region the S3 gateway reports; clients must use the same.
S3_REGION=us-east-1
# S3 gateway logging: silent, or debug to log every request and response (secrets masked).
S3_LOG_LEVEL=silent

# --- Pipelines ---
# Hugging Face token for gated repos in the download-datasets-hf and download-models-hf workflows (stored as a Gitea secret). Optional.
HF_TOKEN=
